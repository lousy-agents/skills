@@ -0,0 +1,6 @@
+export function toCsv(rows) {
+  if (rows.length === 0) return "";
+  const header = Object.keys(rows[0]);
+  const lines = rows.map((row) => header.map((key) => String(row[key])).join(","));
+  return [header.join(","), ...lines].join("\n");
+}
