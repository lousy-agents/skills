"diff --git a/README.md b/README.md\nindex 2f849f6..a6291f2 100644\n--- a/README.md\n+++ b/README.md\n@@ -1,3 +1,7 @@\n # @acme/ledger\n \n Invoice arithmetic for Acme billing services.\n+\n+## CSV export\n+\n+`toCsv(lines)` renders invoice lines as `sku,amount` rows.\ndiff --git a/src/csv.js b/src/csv.js\nnew file mode 100644\nindex 0000000..9c1b9dc\n--- /dev/null\n+++ b/src/csv.js\n@@ -0,0 +1,5 @@\n+import { roundCents } from \"./money.js\";\n+\n+export function toCsv(lines) {\n+  return lines.map((line) => `${line.sku},${roundCents(line.amount)}`).join(\"\\n\");\n+}\ndiff --git a/test/csv.test.js b/test/csv.test.js\nnew file mode 100644\nindex 0000000..d6b4470\n--- /dev/null\n+++ b/test/csv.test.js\n@@ -0,0 +1,7 @@\n+import { test } from \"node:test\";\n+import assert from \"node:assert/strict\";\n+import { toCsv } from \"../src/csv.js\";\n+\n+test(\"toCsv renders one row per line\", () => {\n+  assert.equal(toCsv([{ sku: \"A1\", amount: 1.234 }]), \"A1,1.23\");\n+});\n"
